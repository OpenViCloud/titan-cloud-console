# Titan Portal — build-time variables. Copy to .env.local for local development.
# `npm run dev` reads the API and Keycloak settings from the dev cluster (local-mac): vite.config.ts proxies /v1 to
# http://api.localhost:8080 and serves that cluster's /config.json. Start the cluster first (local-cluster/mac).

# SePay (VietQR top-up) — merchant bank account the customer transfers to.
# The webhook Apikey lives server-side (SePay__ApiKey), NOT here.
VITE_SEPAY_ACC=0000000000
VITE_SEPAY_BANK=MBBank
